{
  "name": "open-components",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "node scripts/fetch-history.mjs && nuxt generate",
    "build:mcp": "nuxt build mcp",
    "dev": "nuxt dev",
    "dev:mcp": "node scripts/dev-mcp.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && nuxt prepare mcp",
    "check-types": "vue-tsc -b --pretty false . mcp plugins 2>&1 | awk '/^[^ ]/ { own = !/^node_modules\\/(.*\\/)?docus\\// } own { print; failed = 1 } END { exit failed }'",
    "check-reference": "node scripts/check-reference.mjs",
    "check-mcp": "node scripts/check-mcp.mjs",
    "check-seo": "node scripts/check-seo.mjs",
    "test": "vitest run",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@amplitude/session-replay-browser": "^1.53.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nuxt/content": "^3.17.0",
    "@nuxtjs/mcp-toolkit": "^0.24.3",
    "@nuxtjs/partytown": "^2.0.0",
    "@uxfront/layer-docs": "^0.9.0",
    "@uxfront/layer-ui": "^0.1.11",
    "@uxfront/scene": "^0.5.1",
    "@uxfront/ui": "^0.9.1",
    "docus": "^5.15.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.6.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.13",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "github-slugger": "^2.0.0",
    "jsdom": "^31.0.1",
    "lightningcss": "^1.33.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.166.0",
    "yaml": "^2.9.1"
  }
}
