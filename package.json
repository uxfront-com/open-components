{
  "name": "open-components",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "nuxt generate",
    "build:mcp": "nuxt build mcp",
    "dev": "nuxt dev",
    "dev:mcp": "node scripts/dev-mcp.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && nuxt prepare mcp",
    "check-types": "vue-tsc -b --pretty false . mcp 2>&1 | awk '/^[^ ]/ { own = !/^node_modules\\/(.*\\/)?docus\\// } own { print; failed = 1 } END { exit failed }'",
    "check-reference": "node scripts/check-reference.mjs",
    "check-mcp": "node scripts/check-mcp.mjs",
    "test": "vitest run",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@amplitude/session-replay-browser": "^1.51.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@nuxt/content": "^3.16.1",
    "@nuxtjs/mcp-toolkit": "^0.19.0",
    "@nuxtjs/partytown": "^2.0.0",
    "@uxfront/layer-docs": "^0.7.0",
    "@uxfront/layer-ui": "^0.1.5",
    "@uxfront/scene": "^0.3.0",
    "@uxfront/ui": "^0.4.2",
    "docus": "^5.13.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.13.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "github-slugger": "^2.0.0",
    "jsdom": "^30.1.1",
    "lightningcss": "^1.33.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.147.0",
    "yaml": "^2.9.1"
  }
}
